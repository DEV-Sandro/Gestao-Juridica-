rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================
    function autenticado() {
      return request.auth != null;
    }

    function meuUid() {
      return request.auth.uid;
    }

    function ehAdmin() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(meuUid()))
        && get(/databases/$(database)/documents/usuarios/$(meuUid())).data.role == 'ADMIN';
    }

    // Tenant (escritório) do usuário logado, lido do próprio doc de usuário.
    function meuTenant() {
      return get(/databases/$(database)/documents/usuarios/$(meuUid())).data.tenantId;
    }

    // Defesa em profundidade multi-tenant: recurso pertence ao escritório do usuário.
    function mesmoTenant(recurso) {
      return autenticado() && recurso.tenantId == meuTenant();
    }

    function ehAdvogado() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(meuUid()))
        && (get(/databases/$(database)/documents/usuarios/$(meuUid())).data.role == 'ADVOGADO'
            || get(/databases/$(database)/documents/usuarios/$(meuUid())).data.role == 'ADMIN');
    }

    // Agenda individual: advogado comum so enxerga os proprios processos.
    // ADMIN mantem visao geral do escritorio.
    function podeVerProcesso(processo) {
      return ehAdmin()
        || (autenticado()
            && get(/databases/$(database)/documents/usuarios/$(meuUid())).data.role == 'ADVOGADO'
            && (processo.advogadoId == null || processo.advogadoId == meuUid()))
        || processo.clienteId == meuUid();
    }

    // ============================================================
    // USUÁRIOS
    // ============================================================
    // Cada usuário lê seu próprio doc; admin lê todos.
    // Escrita só via backend (admin SDK ignora rules), nunca direto pelo cliente.
    match /usuarios/{uid} {
      // O próprio doc sempre; admin só vê membros do mesmo escritório.
      allow read: if autenticado()
        && (meuUid() == uid || (ehAdmin() && mesmoTenant(resource.data)));
      allow write: if false;
    }

    // ============================================================
    // PROCESSOS
    // ============================================================
    // Clientes leem só os próprios; advogado comum só os que é responsável
    // (advogadoId); admin mantém a visão geral do escritório.
    // Escrita só via backend.
    match /processos/{processoId} {
      allow read: if autenticado()
        && mesmoTenant(resource.data)
        && podeVerProcesso(resource.data);
      allow write: if false;

      // ETAPAS (subcoleção) — herdam o escopo do processo pai.
      match /etapas/{etapaId} {
        allow read: if autenticado()
          && mesmoTenant(get(/databases/$(database)/documents/processos/$(processoId)).data)
          && podeVerProcesso(get(/databases/$(database)/documents/processos/$(processoId)).data);
        allow write: if false;
      }
    }

    // ============================================================
    // AUDITORIA — só leitura para admin, escrita só via backend
    // ============================================================
    match /auditoria/{eventoId} {
      allow read: if ehAdmin() && mesmoTenant(resource.data);
      allow write: if false;
    }

    // ============================================================
    // CONFIGURAÇÕES — só admin lê e só backend escreve
    // ============================================================
    match /configuracoes/{docId} {
      allow read: if ehAdmin();
      allow write: if false;
    }

    // ============================================================
    // TEMPLATES (Feature 2 — gerador de documentos, futuro)
    // ============================================================
    match /templates/{templateId} {
      allow read: if ehAdvogado() && mesmoTenant(resource.data);
      allow write: if false;
    }

    // ============================================================
    // FALLBACK — bloqueia tudo o resto
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
